# Required production database
DATABASE_URL=

# Google Identity Services OAuth Web Client ID (not a secret)
GOOGLE_CLIENT_ID=

# Required for session signing/storage integrations
BOS_SESSION_SECRET=

# Required to encrypt integration credentials at rest. Use 32 random bytes as 64 hex characters.
BOS_ENCRYPTION_KEY=

# Required for signed inbound BOS webhook endpoints
BOS_WEBHOOK_SECRET=

# HTTP listener
PORT=3000
# Optional structured logger level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
# WhatsApp Cloud API Graph version
WHATSAPP_GRAPH_VERSION=v23.0
# Optional error tracking configuration for deployment wiring
SENTRY_DSN=
