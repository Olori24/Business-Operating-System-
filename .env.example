# Required production database
DATABASE_URL=

# Google Identity Services OAuth Web Client ID (not a secret)
GOOGLE_CLIENT_ID=

# Required for session signing/storage integrations
BOS_SESSION_SECRET=

# Required to encrypt integration credentials at rest. Use 32 random bytes as 64 hex characters.
BOS_ENCRYPTION_KEY=

# Required for signed inbound BOS webhook endpoints
BOS_WEBHOOK_SECRET=

# Vercel cron authentication secret
CRON_SECRET=

# Public application URL used in account emails
BOS_APP_URL=https://your-bos-domain.example

# Optional Resend delivery for verification/reset/invitation emails
RESEND_API_KEY=
BOS_EMAIL_FROM=

# HTTP listener
PORT=3000
LOG_LEVEL=info
WHATSAPP_GRAPH_VERSION=v23.0
SENTRY_DSN=
