{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health.js" },
    { "source": "/api/v1/auth/google-config", "destination": "/api/[...path].js" },
    { "source": "/api/v1/auth/google", "destination": "/api/[...path].js" },
    { "source": "/api/v1/auth/me", "destination": "/api/[...path].js" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/start", "destination": "/apps/dashboard/onboarding.html" },
    { "source": "/onboarding", "destination": "/apps/dashboard/onboarding.html" },
    { "source": "/dashboard", "destination": "/apps/dashboard/index.html" },
    { "source": "/workflows", "destination": "/apps/dashboard/workflows.html" },
    { "source": "/ai-employees", "destination": "/apps/dashboard/ai-employees.html" },
    { "source": "/integrations", "destination": "/apps/dashboard/integrations.html" },
    { "source": "/execution", "destination": "/apps/dashboard/execution.html" },
    { "source": "/analytics", "destination": "/apps/dashboard/analytics.html" },
    { "source": "/billing", "destination": "/apps/dashboard/billing.html" },
    { "source": "/support", "destination": "/apps/dashboard/support.html" },
    { "source": "/launch", "destination": "/apps/dashboard/launch-readiness.html" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
